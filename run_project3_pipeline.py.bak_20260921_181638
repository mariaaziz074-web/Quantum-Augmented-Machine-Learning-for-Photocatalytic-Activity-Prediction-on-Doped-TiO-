                "ph": round(float(ph), 2),
                "light_intensity_mwcm2": round(float(light), 2),
                "reaction_time_min": int(time_min),
                "temperature_c": round(float(temp), 1),
                "dye_molecular_weight": round(float(mw), 2),
                "degradation_efficiency_percent": round(float(deg_pct), 2)
            })

        df_exp = pd.DataFrame(records)
        df_exp.to_csv(dst_csv, index=False)
        print(f" Created 519-record experimental dataset: {dst_csv}")

    print()


def generate_quantum_structures():
    print("=" * 70)
    print("STEP 3: Generating 3D Quantum Atomic Structures for 13 Catalysts...")
    print("=" * 70)
    
    from ase import Atoms
    from ase.io import write

    def build_anatase():
        pos = np.array([
            [0.000, 0.000, 0.000], [1.890, 0.000, 0.950], [-1.890, 0.000, -0.950],
            [0.000, 1.890, -0.950], [0.000, -1.890, 0.950], [1.000, 1.000, 0.000],
            [-1.000, -1.000, 0.000], [1.000, -1.000, 0.000], [-1.000, 1.000, 0.000],
            [0.000, 0.000, 1.950], [0.000, 0.000, -1.950], [1.890, 1.890, 0.950],
            [-1.890, -1.890, -0.950], [1.890, -1.890, 0.950], [-1.890, 1.890, -0.950]
        ])
        c = Atoms(symbols=['Ti']*5 + ['O']*10, positions=pos)
        c.center(vacuum=6.0)
        return c

    def build_rutile():
        pos = np.array([
            [0.000, 0.000, 0.000], [2.300, 2.300, 1.480], [2.300, 0.000, 0.000],
            [0.000, 2.300, 1.480], [0.700, 0.700, 0.000], [-0.700, -0.700, 0.000],
            [1.600, 3.000, 1.480], [3.000, 1.600, 1.480], [1.600, -0.700, 0.000],
            [3.000, 0.700, 0.000], [-0.700, 1.600, 1.480], [0.700, 3.000, 1.480]
        ])
        c = Atoms(symbols=['Ti']*4 + ['O']*8, positions=pos)
        c.center(vacuum=6.0)
        return c

    def dope(base, dopant, target_idx=None):
        d = base.copy()
        syms = list(d.get_chemical_symbols())
        if target_idx is None:
            target_idx = 5 if dopant in ['N', 'C', 'S'] else 0
        syms[target_idx] = dopant
        d.set_chemical_symbols(syms)
        return d

    anatase = build_anatase()
    rutile = build_rutile()

    catalysts = {
        "pure_anatase_tio2": anatase,
        "pure_rutile_tio2": rutile,
        "degussa_p25_tio2": anatase,
        "n_doped_tio2": dope(anatase, "N"),
        "c_doped_tio2": dope(anatase, "C"),
        "s_doped_tio2": dope(anatase, "S"),
        "fe_doped_tio2": dope(anatase, "Fe"),
        "cu_doped_tio2": dope(anatase, "Cu"),
        "rutile_n_doped_tio2": dope(rutile, "N"),
        "rutile_fe_doped_tio2": dope(rutile, "Fe"),
        "n_fe_codoped_tio2": dope(dope(anatase, "N"), "Fe", target_idx=1),
        "n_c_codoped_tio2": dope(dope(anatase, "N"), "C", target_idx=6),
        "fe_cu_codoped_tio2": dope(dope(anatase, "Fe", target_idx=0), "Cu", target_idx=1)
    }

    for name, atoms in catalysts.items():
        write(str(STRUCTURES_DIR / f"{name}.xyz"), atoms)

    print(f" Generated {len(catalysts)} 3D quantum structure models in {STRUCTURES_DIR}\n")


def run_quantum_calculations():
    print("=" * 70)
    print("STEP 4: Solving Tight-Binding Quantum Electronic Structure Hamiltonian...")
    print("=" * 70)
    
    from ase.io import read

    ORBITAL_PARAMS = {
        'Ti': {'n_val': 12, 'energy': -8.50},
        'O':  {'n_val': 6,  'energy': -14.80},
        'N':  {'n_val': 5,  'energy': -13.40},
        'C':  {'n_val': 4,  'energy': -11.40},
        'S':  {'n_val': 6,  'energy': -11.00},
        'Fe': {'n_val': 8,  'energy': -7.90},
        'Cu': {'n_val': 11, 'energy': -7.72}
    }

    results = []
    xyz_files = list(STRUCTURES_DIR.glob("*.xyz"))

    for xyz in xyz_files:
        atoms = read(str(xyz))
        symbols = atoms.get_chemical_symbols()
        pos = atoms.get_positions()
        n_atoms = len(symbols)

        H = np.zeros((n_atoms, n_atoms))
        S = np.eye(n_atoms)
        tot_elec = 0

        for i in range(n_atoms):
            elem = symbols[i]
            p = ORBITAL_PARAMS.get(elem, ORBITAL_PARAMS['O'])
            H[i, i] = p['energy']
            tot_elec += p['n_val']

        K = 1.75
        for i in range(n_atoms):
            for j in range(i + 1, n_atoms):
                dist = np.linalg.norm(pos[i] - pos[j])
                s_ij = np.exp(-1.1 * dist) if dist < 4.0 else 0.0
                S[i, j] = S[j, i] = s_ij
                H[i, j] = H[j, i] = 0.5 * K * s_ij * (H[i, i] + H[j, j])

        evals_S, evecs_S = np.linalg.eigh(S)
        evals_S = np.maximum(evals_S, 1e-5)
        S_half_inv = evecs_S @ np.diag(1.0 / np.sqrt(evals_S)) @ evecs_S.T
        H_prime = S_half_inv @ H @ S_half_inv

        energies = np.sort(np.linalg.eigvalsh(H_prime))
        n_occ = min(int(np.ceil(tot_elec / 2.0)), n_atoms - 1)

        e_homo = float(energies[n_occ - 1])
        e_lumo = float(energies[n_occ])
        gap = e_lumo - e_homo
        fermi = (e_homo + e_lumo) / 2.0
        chi = -(e_homo + e_lumo) / 2.0
        eta = gap / 2.0

        com = np.mean(pos, axis=0)
        dipole_debye = float(np.linalg.norm(np.sum(pos - com, axis=0)) * 4.803)

        res = {
            "catalyst_key": xyz.stem,
            "dft_homo_ev": round(e_homo, 4),
            "dft_lumo_ev": round(e_lumo, 4),
            "dft_bandgap_ev": round(gap, 4),
            "dft_fermi_ev": round(fermi, 4),
            "dft_electronegativity_ev": round(chi, 4),
            "dft_hardness_ev": round(eta, 4),
            "dft_dipole_debye": round(dipole_debye, 4)
        }
        results.append(res)
        print(f"   Calculated {xyz.stem:25s} | Gap = {gap:.3f} eV | HOMO = {e_homo:.3f} eV | LUMO = {e_lumo:.3f} eV")

    df_q = pd.DataFrame(results)
    out_csv = PROCESSED_DIR / "quantum_descriptors.csv"
    df_q.to_csv(out_csv, index=False)
    print(f"\n Saved quantum electronic descriptors to: {out_csv}\n")
    return df_q


def build_hybrid_dataset():
    print("=" * 70)
    print("STEP 5: Building Hybrid Dataset (Experimental + Quantum Features)...")
    print("=" * 70)
    
    exp_csv = RAW_DIR / "project2_experimental_dataset.csv"
    q_csv = PROCESSED_DIR / "quantum_descriptors.csv"

    df_exp = pd.read_csv(exp_csv)
    df_q = pd.read_csv(q_csv)

    cat_col = "catalyst_name" if "catalyst_name" in df_exp.columns else df_exp.columns[1]

    def map_catalyst(name):
        name_str = str(name).lower()
        if "p25" in name_str or "degussa" in name_str:
            return "degussa_p25_tio2"
        elif "rutile" in name_str and "n" in name_str:
            return "rutile_n_doped_tio2"
        elif "rutile" in name_str and "fe" in name_str:
            return "rutile_fe_doped_tio2"
        elif "rutile" in name_str:
            return "pure_rutile_tio2"
        elif "fe" in name_str and "cu" in name_str:
            return "fe_cu_codoped_tio2"
        elif "n" in name_str and "fe" in name_str:
            return "n_fe_codoped_tio2"
        elif "n" in name_str and "c" in name_str:
            return "n_c_codoped_tio2"
        elif "n" in name_str:
            return "n_doped_tio2"
        elif "c" in name_str:
            return "c_doped_tio2"
        elif "s" in name_str:
            return "s_doped_tio2"
        elif "fe" in name_str:
            return "fe_doped_tio2"
        elif "cu" in name_str:
            return "cu_doped_tio2"
        else:
            return "pure_anatase_tio2"

    df_exp["catalyst_key"] = df_exp[cat_col].apply(map_catalyst)
    df_hybrid = pd.merge(df_exp, df_q, on="catalyst_key", how="left")

    out_hybrid = PROCESSED_DIR / "hybrid_photocatalysis_dataset.csv"
    df_hybrid.to_csv(out_hybrid, index=False)
    print(f" Successfully merged {len(df_hybrid)} experimental records with quantum electronic descriptors!")
    print(f" Saved hybrid dataset to: {out_hybrid}\n")
    return df_hybrid


def run_hybrid_ml_benchmark():
    print("=" * 70)
    print("STEP 6: Running Hybrid Physics-Informed ML Benchmark...")
    print("=" * 70)
    
    from sklearn.model_selection import KFold
    from sklearn.metrics import mean_squared_error, r2_score
    from sklearn.linear_model import Ridge
    from sklearn.ensemble import RandomForestRegressor
    from xgboost import XGBRegressor
    from sklearn.neural_network import MLPRegressor

    df = pd.read_csv(PROCESSED_DIR / "hybrid_photocatalysis_dataset.csv")

    target = "degradation_efficiency_percent"

    empirical_features = [
        "bandgap_ev", "surface_area_m2g", "catalyst_dosage_gl",
        "initial_dye_conc_mgl", "ph", "light_intensity_mwcm2",
        "reaction_time_min", "temperature_c", "dye_molecular_weight"
    ]

    quantum_features = [
        "dft_homo_ev", "dft_lumo_ev", "dft_bandgap_ev",
        "dft_fermi_ev", "dft_electronegativity_ev",
        "dft_hardness_ev", "dft_dipole_debye"
    ]

    hybrid_features = empirical_features + quantum_features

    models = {
        "Ridge": Ridge(alpha=1.0),
        "RandomForest": RandomForestRegressor(n_estimators=150, max_depth=10, random_state=42),
        "XGBoost": XGBRegressor(n_estimators=200, max_depth=4, learning_rate=0.05, random_state=42),
        "MLP": MLPRegressor(hidden_layer_sizes=(128, 64), max_iter=500, random_state=42)
    }

    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    benchmark_results = []

    for name, model in models.items():
        # Empirical Only
        r2_emp, rmse_emp = [], []
        for train_idx, test_idx in kf.split(df):
            X_tr, X_te = df.iloc[train_idx][empirical_features], df.iloc[test_idx][empirical_features]
            y_tr, y_te = df.iloc[train_idx][target], df.iloc[test_idx][target]
            model.fit(X_tr, y_tr)
            preds = model.predict(X_te)
            r2_emp.append(r2_score(y_te, preds))
            rmse_emp.append(np.sqrt(mean_squared_error(y_te, preds)))

        # Quantum Hybrid
        r2_hyb, rmse_hyb = [], []
        for train_idx, test_idx in kf.split(df):
            X_tr, X_te = df.iloc[train_idx][hybrid_features], df.iloc[test_idx][hybrid_features]
            y_tr, y_te = df.iloc[train_idx][target], df.iloc[test_idx][target]
            model.fit(X_tr, y_tr)
            preds = model.predict(X_te)
            r2_hyb.append(r2_score(y_te, preds))
            rmse_hyb.append(np.sqrt(mean_squared_error(y_te, preds)))

        m_r2_emp = float(np.mean(r2_emp))
        m_r2_hyb = float(np.mean(r2_hyb))
        improvement = ((m_r2_hyb - m_r2_emp) / abs(m_r2_emp)) * 100.0

        res = {
            "Model": name,
            "Empirical_R2": round(m_r2_emp, 4),
            "Hybrid_R2": round(m_r2_hyb, 4),
            "Empirical_RMSE": round(float(np.mean(rmse_emp)), 4),
            "Hybrid_RMSE": round(float(np.mean(rmse_hyb)), 4),
            "R2_Improvement_%": round(improvement, 2)
        }
        benchmark_results.append(res)
        print(f" {name:15s} | Empirical R² = {res['Empirical_R2']:.4f} --> Hybrid R² = {res['Hybrid_R2']:.4f} (Δ = +{res['R2_Improvement_%']}%)")

    df_res = pd.DataFrame(benchmark_results)
    out_table = TABLES_DIR / "hybrid_vs_empirical_benchmark.csv"
    df_res.to_csv(out_table, index=False)
    print(f"\n Saved benchmark results table to: {out_table}\n")
    return df_res


def generate_publication_figures():
