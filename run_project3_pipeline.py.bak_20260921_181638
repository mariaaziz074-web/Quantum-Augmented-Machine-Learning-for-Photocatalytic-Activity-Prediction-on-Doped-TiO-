            "n_c_codoped_tio2": "N–C co-doped",
            "fe_cu_codoped_tio2": "Fe–Cu co-doped",
            "degussa_p25_tio2": "Degussa P25",
        }
        return mapping.get(k, str(key))

    # ==============================================================
    # Figure 1: Band alignment + gap
    # ==============================================================
    q_csv = PROCESSED_DIR / "quantum_descriptors.csv"
    if q_csv.exists():
        df_q = pd.read_csv(q_csv).copy()
        df_q = df_q.sort_values("dft_bandgap_ev", ascending=False).reset_index(drop=True)

        needed = {"catalyst_key", "dft_homo_ev", "dft_lumo_ev", "dft_bandgap_ev"}
        if not needed.issubset(set(df_q.columns)):
            print(" Warning: quantum_descriptors.csv missing expected columns; skipping Figure 1.")
        else:
            n = len(df_q)
            labels = [catalyst_label(x) for x in df_q["catalyst_key"].tolist()]

            homo = df_q["dft_homo_ev"].astype(float).to_numpy()
            lumo = df_q["dft_lumo_ev"].astype(float).to_numpy()
            gaps = df_q["dft_bandgap_ev"].astype(float).to_numpy()
            y = np.arange(n)

            energy_min = float(min(homo.min(), lumo.min()))
            energy_max = float(max(homo.max(), lumo.max()))
            pad = max(0.35, 0.07 * (energy_max - energy_min))
            xlim = (energy_min - pad, energy_max + pad)

            fig = plt.figure(figsize=(12.8, 7.0), dpi=600, facecolor=bg_face)
            gs = gridspec.GridSpec(
                1, 3,
                width_ratios=[1.6, 7.2, 2.1],
                wspace=0.08
            )

            ax_lab = fig.add_subplot(gs[0, 0], facecolor=panel_face)
            ax_band = fig.add_subplot(gs[0, 1], facecolor=panel_face)
            ax_gap = fig.add_subplot(gs[0, 2], facecolor=panel_face, sharey=ax_band)

            # Label column (no axis)
            ax_lab.set_xlim(0, 1)
            ax_lab.set_ylim(-0.5, n - 0.5)
            ax_lab.axis("off")
            for i in range(n):
                ax_lab.text(0.03, i, labels[i], ha="left", va="center",
                            fontsize=10.2, color=axis_col)

            # Band panel
            ax_band.set_xlim(*xlim)
            ax_band.set_ylim(-0.5, n - 0.5)
            ax_band.grid(True, axis="x", linestyle="--", alpha=0.28, color=grid_col)
            ax_band.grid(False, axis="y")

            for i in range(n):
                ax_band.plot([homo[i], lumo[i]], [y[i], y[i]],
                             color=col_gap, linewidth=2.3, alpha=0.9, zorder=2)
                ax_band.scatter([homo[i]], [y[i]], s=42, color=col_homo,
                                edgecolor="white", linewidth=0.55, zorder=3)
                ax_band.scatter([lumo[i]], [y[i]], s=42, color=col_lumo,
                                edgecolor="white", linewidth=0.55, marker="D", zorder=3)

            ax_band.set_yticks(y)
            ax_band.set_yticklabels([])
            ax_band.tick_params(axis="y", left=False, labelleft=False)
            ax_band.set_xlabel("Energy level vs. vacuum (eV)",
                               fontsize=11, fontweight="bold", color=axis_col)
            ax_band.set_title("Quantum electronic structure: band alignment & frontier levels",
                               fontsize=13.0, pad=12, color=axis_col)

            legend_handles = [
                Line2D([0], [0], color=col_homo, marker="o", linestyle="None", markersize=6, label="HOMO"),
                Line2D([0], [0], color=col_lumo, marker="D", linestyle="None", markersize=6, label="LUMO"),
                Line2D([0], [0], color=col_gap, linestyle="-", linewidth=2.2, label="Gap (HOMO→LUMO)"),
            ]
            ax_band.legend(
                handles=legend_handles,
                loc="upper left",
                frameon=True,
                facecolor="white",
                framealpha=0.95,
                edgecolor="#D1D5DB",
                fontsize=9.5,
                borderpad=0.5
            )

            # Gap bars panel (muted teal, not loud green)
            ax_gap.barh(y, gaps, height=0.62, color=col_gap, alpha=0.78, edgecolor="none")
            ax_gap.grid(True, axis="x", linestyle="--", alpha=0.22, color=grid_col)
            ax_gap.set_yticks(y)
            ax_gap.set_yticklabels([])
            ax_gap.tick_params(axis="y", left=False, labelleft=False)
            ax_gap.set_xlabel("Bandgap $E_g$ (eV)",
                               fontsize=11, fontweight="bold", color=axis_col)

            fig.subplots_adjust(left=0.03, right=0.995, top=0.90, bottom=0.14)

            fig1_png = FIGURES_DIR / "fig1_quantum_band_structures.png"
            fig1_pdf = FIGURES_DIR / "fig1_quantum_band_structures.pdf"
            fig.savefig(fig1_png, bbox_inches="tight", pad_inches=0.02)
            fig.savefig(fig1_pdf, bbox_inches="tight", pad_inches=0.02)
            plt.close(fig)
            print(f" Saved Figure 1: {fig1_png}")

    # ==============================================================
    # Figure 2: R2 bars
    # ==============================================================
    bm_csv = TABLES_DIR / "hybrid_vs_empirical_benchmark.csv"
